int limite = 5;

fn bool positivo(int numero) {
    return numero > 0;
}

fn void contar() {
    int i = 0;
    while (i < limite) {
        if (positivo(i)) {
            if (i == 3) {
                i = i + 1;
            } else {
                i = i + 2;
            }
        } else {
            i = i + 1;
        }
    }
    return;
}

fn void main() {
    contar();
}
