fn int soma(int a, int b) {
    return a + b;
}

fn void main() {
    int total = soma(10, 20);
    double media = 3.14;
    bool pronto = true;
    char inicial = 'L';
    string mensagem = "total=\n";

    // comentarios de linha sao ignorados
    if (pronto && total >= 30) {
        while (total > 0) {
            total = total - 1;
        }
    } else {
        total = 0;
    }
}
